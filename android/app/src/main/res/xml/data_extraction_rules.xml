<?xml version="1.0" encoding="utf-8"?>
<!--
    Regras de extração de dados (Android 12+): backup na nuvem e
    transferência direta entre aparelhos.

    Log de erros, lixeira, banco e preferências ficam de fora. O app não tem
    conta nem telemetria; o usuário controla o que sai por "Exportar
    relatório de diagnóstico".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="trash/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="trash/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
