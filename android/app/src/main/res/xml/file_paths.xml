<?xml version="1.0" encoding="utf-8"?>
<!--
    Caminhos expostos pelo FileProvider do Audify.

    Só o armazenamento compartilhado é exposto, porque é de onde vêm as
    fotos/vídeos/PDFs que o usuário manda para o papel de parede ou para um
    editor externo. A permissão continua temporária e por arquivo
    (`grantUriPermissions` no manifest).

    NÃO exponha aqui `files-path`, `cache-path` nem `external-files-path`:
    eles dariam URI para o banco de playlists, o manifesto da lixeira e o
    crash_log.txt (dados privados do app).
-->
<paths>
    <external-path name="shared" path="." />
</paths>
